# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.

# 永豐金證券 (Sinopac/Shioaji) API credentials
SJ_API_KEY=
SJ_SEC_KEY=

# Only needed for production mode (real trading/account data). Simulation
# mode (quotes/market data) generally doesn't require the CA cert.
SJ_CA_PATH=
SJ_CA_PASSWD=

# false = simulation mode, true = production/live mode
SJ_PRODUCTION=false

# Port the shioaji quote service listens on (see shioaji.exe server --help)
SJ_HTTP_ADDR=127.0.0.1:8090
